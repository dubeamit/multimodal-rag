# ==============================================================================
# Multimodal RAG Backend Environment Variables
# ==============================================================================

# Local LLM Server (e.g., llama.cpp server, Ollama, vLLM)
LLM_BASE_URL="http://127.0.0.1:8080/v1"

# Google Gemini API Key (optional, used when Gemini mode is selected in UI)
# GEMINI_API_KEY="your-gemini-api-key"

# Speech-to-Text Configuration (defaults to relative paths if unset)
# WHISPER_CLI="./speech2text/whisper.cpp/build/bin/whisper-cli"
# STT_MODEL_PATH="./models/zero-stt-hinglish/ggml-model.bin"
# TRANSCRIPTION_SCRIPT_PATH="./speech2text/transcribe.sh"
